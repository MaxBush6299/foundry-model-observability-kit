      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{Deployment}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2024-10-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.properties.rateLimits[*]\",\"columns\":[{\"path\":\"$.key\",\"columnid\":\"Limit kind\",\"columnType\":\"string\"},{\"path\":\"$.count\",\"columnid\":\"Count\",\"columnType\":\"real\"},{\"path\":\"$.renewalPeriod\",\"columnid\":\"Renewal period (seconds)\",\"columnType\":\"real\"}]}}]}",
