      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{Deployment}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2024-10-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"path\":\"$.id\",\"columnid\":\"Deployment resource ID\",\"columnType\":\"string\"},{\"path\":\"$.sku.name\",\"columnid\":\"Deployment type\",\"columnType\":\"string\"},{\"path\":\"$.sku.capacity\",\"columnid\":\"SKU capacity units (not TPM)\",\"columnType\":\"real\"},{\"path\":\"$.properties.dynamicThrottlingEnabled\",\"columnid\":\"Dynamic throttling\",\"columnType\":\"boolean\"}]}}]}",
