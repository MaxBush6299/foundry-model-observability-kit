    {
      "type": 1,
      "name": "tokens-label",
      "content": {
        "json": "### Processed tokens/minute vs current allocated TPM (approximate)\n`TotalTokens`, Sum, PT1M. Azure admission throttling uses **arrival-time estimated tokens** (including requested output), not these processed-token totals. Below-limit processed traffic can still receive 429s. Do not interpret this as exact throttling headroom or billed cost."
      }
    },
    {
      "type": 3,
      "name": "tokens-vs-tpm",
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{FoundryResource}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2018-01-01\"},{\"key\":\"metricnames\",\"value\":\"TotalTokens\"},{\"key\":\"aggregation\",\"value\":\"Total\"},{\"key\":\"interval\",\"value\":\"PT1M\"},{\"key\":\"autoAdjustTimegrain\",\"value\":\"false\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"$filter\",\"value\":\"ModelDeploymentName eq '{Deployment:label}'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries[0].data[*]\",\"columns\":[{\"path\":\"$.timeStamp\",\"columnid\":\"Time\",\"columnType\":\"datetime\"},{\"path\":\"$.total\",\"columnid\":\"Processed tokens/minute\",\"columnType\":\"real\"}]}}]}",
        "queryType": 12,
        "size": 0,
        "visualization": "timechart",
        "chartSettings": {
          "xAxis": "Time",
          "yAxis": [
            "Processed tokens/minute"
          ],
          "showLegend": true,
          "showMetrics": false,
          "customThresholdLine": "{TPM}",
          "customThresholdLineStyle": 1
        },
        "timeContextFromParameter": "TimeRange",
        "noDataMessage": "No reported samples for this deployment/metric. Missing is not zero."
      },
      "conditionalVisibility": {
        "parameterName": "TPM",
        "comparison": "isNotEqualTo",
        "value": "Unavailable"
      }
    },
    {
      "type": 3,
      "name": "tokens-vs-tpm-unavailable",
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{FoundryResource}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2018-01-01\"},{\"key\":\"metricnames\",\"value\":\"TotalTokens\"},{\"key\":\"aggregation\",\"value\":\"Total\"},{\"key\":\"interval\",\"value\":\"PT1M\"},{\"key\":\"autoAdjustTimegrain\",\"value\":\"false\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"$filter\",\"value\":\"ModelDeploymentName eq '{Deployment:label}'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries[0].data[*]\",\"columns\":[{\"path\":\"$.timeStamp\",\"columnid\":\"Time\",\"columnType\":\"datetime\"},{\"path\":\"$.total\",\"columnid\":\"Processed tokens/minute\",\"columnType\":\"real\"}]}}]}",
