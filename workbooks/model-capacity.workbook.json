    {
      "type": 9,
      "name": "investigation-parameters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "FoundryResource",
            "version": "KqlParameterItem/1.0",
            "name": "FoundryResource",
            "type": 5,
            "label": "Investigate resource",
            "isRequired": true,
            "value": "value::1",
            "query": "resources | where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions}) | where type =~ 'microsoft.cognitiveservices/accounts' and kind in~ ('AIServices', 'OpenAI') | where id in~ ({FoundryResources}) | extend Preferred=id =~ '__MODEL_ACCOUNT_RESOURCE_ID__' | order by Preferred desc, id asc | project value=id, label=strcat(name, ' (', resourceGroup, ')'), selected=id =~ '__MODEL_ACCOUNT_RESOURCE_ID__'",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::1"
              ],
              "showDefault": false
            }
          },
          {
            "id": "Deployment",
            "version": "KqlParameterItem/1.0",
            "name": "Deployment",
            "type": 2,
            "label": "Detail deployment",
            "isRequired": true,
            "queryType": 12,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{FoundryResource}/deployments\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2024-10-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[*]\",\"columns\":[{\"path\":\"$.id\",\"columnid\":\"value\",\"columnType\":\"string\"},{\"path\":\"$.name\",\"columnid\":\"label\",\"columnType\":\"string\"},{\"path\":\"$.name\",\"columnid\":\"selected\",\"columnType\":\"string\"}]}}]}",
            "typeSettings": {
              "showDefault": false
            }
          },
          {
            "id": "TokenCount",
            "version": "KqlParameterItem/1.0",
            "name": "TokenCount",
            "type": 1,
            "isHiddenWhenLocked": true,
            "queryType": 12,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{Deployment}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2024-10-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.properties.rateLimits[?(@.key=='token')].count\",\"columns\":[]}}]}"
          },
          {
            "id": "TokenWindow",
            "version": "KqlParameterItem/1.0",
            "name": "TokenWindow",
            "type": 1,
            "isHiddenWhenLocked": true,
            "queryType": 12,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{Deployment}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2024-10-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.properties.rateLimits[?(@.key=='token')].renewalPeriod\",\"columns\":[]}}]}"
          },
          {
            "id": "RequestCount",
            "version": "KqlParameterItem/1.0",
            "name": "RequestCount",
            "type": 1,
            "isHiddenWhenLocked": true,
            "queryType": 12,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{Deployment}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2024-10-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.properties.rateLimits[?(@.key=='request')].count\",\"columns\":[]}}]}"
          },
          {
            "id": "RequestWindow",
            "version": "KqlParameterItem/1.0",
            "name": "RequestWindow",
            "type": 1,
            "isHiddenWhenLocked": true,
            "queryType": 12,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{Deployment}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2024-10-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.properties.rateLimits[?(@.key=='request')].renewalPeriod\",\"columns\":[]}}]}"
          },
          {
            "id": "TPM",
            "version": "KqlParameterItem/1.0",
            "name": "TPM",
            "type": 1,
            "isHiddenWhenLocked": true,
            "criteriaData": [
              {
                "criteriaContext": {
                  "leftOperand": "TokenCount",
                  "operator": "is Empty",
                  "resultValType": "static",
                  "resultVal": "Unavailable"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "TokenWindow",
                  "operator": ">",
                  "rightValType": "static",
                  "rightVal": "0",
                  "resultValType": "expression",
                  "resultVal": "60 * {TokenCount} / {TokenWindow}"
                }
              },
              {
                "criteriaContext": {
                  "operator": "Default",
                  "resultValType": "static",
                  "resultVal": "Unavailable"
                }
              }
            ]
          },
          {
            "id": "RPM",
            "version": "KqlParameterItem/1.0",
            "name": "RPM",
            "type": 1,
            "isHiddenWhenLocked": true,
            "criteriaData": [
              {
                "criteriaContext": {
                  "leftOperand": "RequestCount",
                  "operator": "is Empty",
                  "resultValType": "static",
                  "resultVal": "Unavailable"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "RequestWindow",
                  "operator": ">",
                  "rightValType": "static",
                  "rightVal": "0",
                  "resultValType": "expression",
                  "resultVal": "60 * {RequestCount} / {RequestWindow}"
                }
              },
              {
                "criteriaContext": {
                  "operator": "Default",
                  "resultValType": "static",
                  "resultVal": "Unavailable"
                }
              }
            ]
          }
        ],
        "style": "pills"
      }
    },
