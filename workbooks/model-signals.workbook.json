{
  "version": "Notebook/1.0",
  "isLocked": false,
  "fallbackResourceIds": [ "__MODEL_ACCOUNT_RESOURCE_ID__" ],
  "items": [
    {
      "type": 1,
      "name": "intro",
      "content": {
        "json": "## Foundry Model Volume, Latency & Availability\nThree operational signals from Azure Monitor metrics, broken down by model deployment. No diagnostic logs or Application Insights required. Start with the last 24 hours to spot traffic spikes, slow responses, and availability dips. Each visual requests up to 1,000 deployment series. Blank charts or cells mean **no reported samples**, not zero traffic or perfect health."
      }
    },
    {
      "type": 9,
      "name": "parameters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [ "value::selected" ],
        "parameters": [
          {
            "id": "signals-resource",
            "version": "KqlParameterItem/1.0",
            "name": "FoundryResource",
            "label": "Foundry resource",
            "type": 5,
            "isRequired": true,
            "query": "resources | where type =~ 'microsoft.cognitiveservices/accounts' and kind in~ ('AIServices', 'OpenAI') | project value = id, label = name, selected = id =~ '__MODEL_ACCOUNT_RESOURCE_ID__', group = resourceGroup",
            "crossComponentResources": [ "value::selected" ],
            "typeSettings": { "additionalResourceOptions": [] },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "signals-time",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "value": { "durationMs": 86400000 },
            "typeSettings": {
              "selectableValues": [
                { "durationMs": 3600000 },
                { "durationMs": 86400000 },
                { "durationMs": 604800000 },
                { "durationMs": 2592000000 }
              ]
            }
          },
          {
            "id": "signals-latency-metric",
            "version": "KqlParameterItem/1.0",
            "name": "LatencyMetric",
            "label": "Latency metric",
            "type": 2,
            "isRequired": true,
            "value": "TimeToResponse",
            "jsonData": "[{\"value\":\"TimeToResponse\",\"label\":\"Foundry Models - time to response (PTU)\"},{\"value\":\"AzureOpenAITimeToResponse\",\"label\":\"Azure OpenAI - time to response (PTU and pay-as-you-go)\"}]"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      }
    },
    {
      "type": 1,
      "name": "volume-label",
      "content": {
        "json": "### 1. Request volume\nTotal inference requests, including unsuccessful responses. Compare deployments to identify traffic spikes. The trend sums requests within each chart interval; the table gives totals for the entire selected time range."
      }
    },
    {
      "type": 10,
      "name": "volume-trend",
      "content": {
        "chartId": "model-signals-volume",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceIds": [ "{FoundryResource}" ],
        "timeContextFromParameter": "TimeRange",
        "resourceType": "microsoft.cognitiveservices/accounts",
        "metrics": [
          {
            "namespace": "microsoft.cognitiveservices/accounts",
            "metric": "microsoft.cognitiveservices/accounts--ModelRequests",
            "aggregation": 1,
            "splitByLimit": 1000,
            "splitBy": "ModelDeploymentName"
          }
        ]
      }
    },
    {
      "type": 3,
      "name": "volume-summary",
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{FoundryResource}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2018-01-01\"},{\"key\":\"metricnames\",\"value\":\"ModelRequests\"},{\"key\":\"aggregation\",\"value\":\"Total\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"top\",\"value\":\"1000\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"$filter\",\"value\":\"ModelDeploymentName eq '*'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries[*]\",\"columns\":[{\"path\":\"$.metadatavalues[0].value\",\"columnid\":\"Deployment\",\"columnType\":\"string\"},{\"path\":\"$.data[0].total\",\"columnid\":\"Requests\",\"columnType\":\"long\"}]}}]}",
        "size": 0,
        "timeContextFromParameter": "TimeRange",
        "queryType": 12,
        "visualization": "grid"
      }
    },
    {
      "type": 1,
      "name": "latency-label",
      "content": {
        "json": "### 2. Latency - gateway time to response (ms)\nThe trend shows average time to first response per deployment; the table shows the platform-reported average and maximum for the selected range. This is **not end-to-end completion latency or p95** and excludes client-side latency. Foundry Models `TimeToResponse` is documented for PTU workloads. For Azure OpenAI pay-as-you-go deployments, select **Azure OpenAI** in the latency picker. Metric coverage varies; missing samples stay blank."
      }
    },
    {
      "type": 10,
      "name": "latency-trend",
      "content": {
        "chartId": "model-signals-latency",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceIds": [ "{FoundryResource}" ],
        "timeContextFromParameter": "TimeRange",
        "resourceType": "microsoft.cognitiveservices/accounts",
        "metrics": [
          {
            "namespace": "microsoft.cognitiveservices/accounts",
            "metric": "microsoft.cognitiveservices/accounts--TimeToResponse",
            "aggregation": 4,
            "splitByLimit": 1000,
            "splitBy": "ModelDeploymentName"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "LatencyMetric",
        "comparison": "isEqualTo",
        "value": "TimeToResponse"
      }
    },
    {
      "type": 10,
      "name": "openai-latency-trend",
      "content": {
        "chartId": "model-signals-openai-latency",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceIds": [ "{FoundryResource}" ],
        "timeContextFromParameter": "TimeRange",
        "resourceType": "microsoft.cognitiveservices/accounts",
        "metrics": [
          {
            "namespace": "microsoft.cognitiveservices/accounts",
            "metric": "microsoft.cognitiveservices/accounts--AzureOpenAITimeToResponse",
            "aggregation": 4,
            "splitByLimit": 1000,
            "splitBy": "ModelDeploymentName"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "LatencyMetric",
        "comparison": "isEqualTo",
        "value": "AzureOpenAITimeToResponse"
      }
    },
    {
      "type": 3,
      "name": "latency-summary",
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{FoundryResource}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2018-01-01\"},{\"key\":\"metricnames\",\"value\":\"{LatencyMetric}\"},{\"key\":\"aggregation\",\"value\":\"Average,Maximum\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"top\",\"value\":\"1000\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"$filter\",\"value\":\"ModelDeploymentName eq '*'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries[*]\",\"columns\":[{\"path\":\"$.metadatavalues[0].value\",\"columnid\":\"Deployment\",\"columnType\":\"string\"},{\"path\":\"$.data[0].average\",\"columnid\":\"Average latency (ms)\",\"columnType\":\"real\"},{\"path\":\"$.data[0].maximum\",\"columnid\":\"Maximum latency (ms)\",\"columnType\":\"real\"}]}}]}",
        "size": 0,
        "timeContextFromParameter": "TimeRange",
        "queryType": 12,
        "visualization": "grid"
      }
    },
    {
      "type": 1,
      "name": "availability-label",
      "content": {
        "json": "### 3. Availability (%)\nReported availability is `(total calls - server errors) / total calls`, expressed as a percentage. Server errors are HTTP 5xx; **4xx and 429 do not reduce this metric**. The trend shows average reported availability; the table includes the minimum reported sample to highlight brief dips. These are platform metric aggregates, not a request-weighted SLO calculation or an uptime probe. Compare with request volume and Inference Health's status breakdown; no traffic or missing samples do not establish 100% availability."
      }
    },
    {
      "type": 10,
      "name": "availability-trend",
      "content": {
        "chartId": "model-signals-availability",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceIds": [ "{FoundryResource}" ],
        "timeContextFromParameter": "TimeRange",
        "resourceType": "microsoft.cognitiveservices/accounts",
        "metrics": [
          {
            "namespace": "microsoft.cognitiveservices/accounts",
            "metric": "microsoft.cognitiveservices/accounts--ModelAvailabilityRate",
            "aggregation": 4,
            "splitByLimit": 1000,
            "splitBy": "ModelDeploymentName"
          }
        ]
      }
    },
    {
      "type": 3,
      "name": "availability-summary",
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{FoundryResource}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2018-01-01\"},{\"key\":\"metricnames\",\"value\":\"ModelAvailabilityRate\"},{\"key\":\"aggregation\",\"value\":\"Average,Minimum\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"top\",\"value\":\"1000\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"$filter\",\"value\":\"ModelDeploymentName eq '*'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries[*]\",\"columns\":[{\"path\":\"$.metadatavalues[0].value\",\"columnid\":\"Deployment\",\"columnType\":\"string\"},{\"path\":\"$.data[0].average\",\"columnid\":\"Average availability (%)\",\"columnType\":\"real\"},{\"path\":\"$.data[0].minimum\",\"columnid\":\"Minimum availability (%)\",\"columnType\":\"real\"}]}}]}",
        "size": 0,
        "timeContextFromParameter": "TimeRange",
        "queryType": 12,
        "visualization": "grid"
      }
    }
  ]
}
