    {
      "type": 1,
      "name": "metric-response-label",
      "content": {
        "json": "### Selected-resource query coverage\nMetrics List requests up to 1,000 series. A returned count at the cap can mean truncation; the API has no documented next-page/completeness marker. Metric error codes/messages below must not be interpreted as no-data or healthy zeroes. This diagnostic is selected-resource only."
      }
    },
    {
      "type": 3,
      "name": "metric-response-status",
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{FoundryResource}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2018-01-01\"},{\"key\":\"metricnames\",\"value\":\"ModelRequests,ModelAvailabilityRate,{LatencyMetric}\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"top\",\"value\":\"1000\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"$filter\",\"value\":\"ModelDeploymentName eq '*'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[*]\",\"columns\":[{\"path\":\"$.name.value\",\"columnid\":\"Metric\",\"columnType\":\"string\"},{\"path\":\"$.errorCode\",\"columnid\":\"Metric result\",\"columnType\":\"string\"},{\"path\":\"$.errorMessage\",\"columnid\":\"Metric error\",\"columnType\":\"string\"},{\"path\":\"$.timeseries.length\",\"columnid\":\"Series returned\",\"columnType\":\"long\"}]}}]}",
        "queryType": 12,
        "size": 0,
        "visualization": "grid"
      }
    },
    {
      "type": 1,
      "name": "inventory-label",
      "content": {
        "json": "### Inventory and project mappings\nProjects map to parent accounts. Platform metrics are **not project-attributed**. Inventory is RBAC-filtered and may be limited by discovery result caps."
      }
    },
    {
      "type": 3,
      "name": "account-inventory",
      "content": {
        "version": "KqlItem/1.0",
        "query": "resources | where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions}) | where type =~ 'microsoft.cognitiveservices/accounts' and kind in~ ('AIServices', 'OpenAI') | where id in~ ({FoundryResources}) | project Account=name, ResourceGroup=resourceGroup, Subscription=subscriptionId, Region=location, Kind=kind, AccountResourceId=id",
        "queryType": 1,
        "size": 0,
        "visualization": "grid",
        "crossComponentResources": [
          "{Subscriptions}"
        ],
        "resourceType": "microsoft.resourcegraph/resources"
      }
    },
    {
      "type": 3,
      "name": "project-inventory",
      "content": {
        "version": "KqlItem/1.0",
        "query": "resources | where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions}) | where type =~ 'microsoft.cognitiveservices/accounts/projects' | extend AccountResourceId=tostring(split(tolower(id), '/projects/')[0]) | where AccountResourceId in~ ({FoundryResources}) | project Project=name, ResourceGroup=resourceGroup, Subscription=subscriptionId, AccountResourceId, ProjectResourceId=id",
        "queryType": 1,
        "size": 0,
        "visualization": "grid",
        "noDataMessage": "No accessible Foundry projects for the selected accounts.",
        "crossComponentResources": [
          "{Subscriptions}"
        ],
        "resourceType": "microsoft.resourcegraph/resources"
      }
    }
  ]
}
