          "filter": true
        }
      }
    },
    {
      "type": 1,
      "name": "deployment-comparison-label",
      "content": {
        "json": "### Compare resource/deployment signals\nEach row retains account identity and the reported deployment dimension. Availability is 5xx-only, not a 4xx/429 SLO. Latency is first response, not completion or p95. Blank rows do not establish healthy zeroes."
      }
    },
