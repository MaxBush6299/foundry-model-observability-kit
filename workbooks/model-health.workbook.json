{
  "version": "Notebook/1.0",
  "isLocked": false,
  "fallbackResourceIds": [ "__MODEL_ACCOUNT_RESOURCE_ID__" ],
  "items": [
    {
      "type": 1,
      "name": "intro",
      "content": {
        "json": "## Foundry Model Inference Health\nChoose a Foundry resource and time range to inspect inference requests, HTTP responses, availability, and latency. Azure Monitor model metrics require no agent traces or diagnostic export. Missing series mean **no reported samples**, not zero errors or perfect availability."
      }
    },
    {
      "type": 9,
      "name": "parameters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [ "value::selected" ],
        "parameters": [
          {
            "id": "health-resource",
            "version": "KqlParameterItem/1.0",
            "name": "FoundryResource",
            "label": "Foundry resource",
            "type": 5,
            "isRequired": true,
            "query": "resources | where type =~ 'microsoft.cognitiveservices/accounts' and kind in~ ('AIServices', 'OpenAI') | project value = id, label = name, selected = id =~ '__MODEL_ACCOUNT_RESOURCE_ID__', group = resourceGroup",
            "crossComponentResources": [ "value::selected" ],
            "typeSettings": { "additionalResourceOptions": [] },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "health-time",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "value": { "durationMs": 604800000 },
            "typeSettings": {
              "selectableValues": [
                { "durationMs": 3600000 },
                { "durationMs": 86400000 },
                { "durationMs": 604800000 },
                { "durationMs": 2592000000 }
              ]
            }
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      }
    },
    {
      "type": 1,
      "name": "status-label",
      "content": {
        "json": "### HTTP responses over time\nRequest totals by status code across the selected resource. Watch for 429 throttling, 4xx client errors, and 5xx server errors; a blank chart does not establish zero failures."
      }
    },
    {
      "type": 10,
      "name": "requests-status",
      "content": {
        "chartId": "model-health-status",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceIds": [ "{FoundryResource}" ],
        "timeContextFromParameter": "TimeRange",
        "resourceType": "microsoft.cognitiveservices/accounts",
        "metrics": [
          {
            "namespace": "microsoft.cognitiveservices/accounts",
            "metric": "microsoft.cognitiveservices/accounts--ModelRequests",
            "aggregation": 1,
            "splitBy": "StatusCode"
          }
        ]
      }
    },
    {
      "type": 1,
      "name": "status-detail-label",
      "content": {
        "json": "### Requests by HTTP status\nHTTP statuses are columns with request counts for the selected resource and time range, across all deployments. A status without samples may be absent or have a blank cell; blank does not mean a measured zero."
      }
    },
    {
      "type": 10,
      "name": "status-totals",
      "content": {
        "chartId": "model-health-status-totals",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 0,
        "resourceIds": [ "{FoundryResource}" ],
        "timeContextFromParameter": "TimeRange",
        "resourceType": "microsoft.cognitiveservices/accounts",
        "metrics": [
          {
            "namespace": "microsoft.cognitiveservices/accounts",
            "metric": "microsoft.cognitiveservices/accounts--ModelRequests",
            "aggregation": 1,
            "splitBy": "StatusCode"
          }
        ]
      }
    },
    {
      "type": 1,
      "name": "status-by-deployment-label",
      "content": {
        "json": "### Deployment detail\nFor a specific deployment, find its HTTP status and request count here. Each row is one reported deployment and status combination; blank results do not establish zero errors."
      }
    },
    {
      "type": 3,
      "name": "status-by-deployment",
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{FoundryResource}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2018-01-01\"},{\"key\":\"metricnames\",\"value\":\"ModelRequests\"},{\"key\":\"aggregation\",\"value\":\"Total\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"$filter\",\"value\":\"ModelDeploymentName eq '*' and StatusCode eq '*'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries[*]\",\"columns\":[{\"path\":\"$.metadatavalues[0].value\",\"columnid\":\"Deployment\",\"columnType\":\"string\"},{\"path\":\"$.metadatavalues[1].value\",\"columnid\":\"HTTP status\",\"columnType\":\"string\"},{\"path\":\"$.data[0].total\",\"columnid\":\"Requests\",\"columnType\":\"long\"}]}}]}",
        "size": 0,
        "timeContextFromParameter": "TimeRange",
        "queryType": 12,
        "visualization": "grid"
      }
    },
    {
      "type": 1,
      "name": "availability-label",
      "content": {
        "json": "### Reported availability by deployment (%)\nPlatform average availability uses server errors (HTTP 5xx), not all unsuccessful requests; 429 and 4xx are not included. Availability can be reported even in intervals with no traffic. Compare with the status breakdown before drawing conclusions."
      }
    },
    {
      "type": 10,
      "name": "availability",
      "content": {
        "chartId": "model-health-availability",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceIds": [ "{FoundryResource}" ],
        "timeContextFromParameter": "TimeRange",
        "resourceType": "microsoft.cognitiveservices/accounts",
        "metrics": [
          {
            "namespace": "microsoft.cognitiveservices/accounts",
            "metric": "microsoft.cognitiveservices/accounts--ModelAvailabilityRate",
            "aggregation": 4,
            "splitBy": "ModelDeploymentName"
          }
        ]
      }
    },
    {
      "type": 1,
      "name": "latency-label",
      "content": {
        "json": "### Time to response by deployment (ms)\nAverage gateway time to first response for streaming requests. Documented for PTU deployments; availability varies by model and provider. It excludes client-side latency."
      }
    },
    {
      "type": 10,
      "name": "latency",
      "content": {
        "chartId": "model-health-latency",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceIds": [ "{FoundryResource}" ],
        "timeContextFromParameter": "TimeRange",
        "resourceType": "microsoft.cognitiveservices/accounts",
        "metrics": [
          {
            "namespace": "microsoft.cognitiveservices/accounts",
            "metric": "microsoft.cognitiveservices/accounts--TimeToResponse",
            "aggregation": 4,
            "splitBy": "ModelDeploymentName"
          }
        ]
      }
    },
    {
      "type": 1,
      "name": "traffic-label",
      "content": {
        "json": "### Traffic by deployment\nTotal requests including failures. Correlate traffic shifts with HTTP responses, availability, and latency. For individual request investigation, enable resource diagnostics to Log Analytics separately."
      }
    },
    {
      "type": 10,
      "name": "requests-deployment",
      "content": {
        "chartId": "model-health-traffic",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceIds": [ "{FoundryResource}" ],
        "timeContextFromParameter": "TimeRange",
        "resourceType": "microsoft.cognitiveservices/accounts",
        "metrics": [
          {
            "namespace": "microsoft.cognitiveservices/accounts",
            "metric": "microsoft.cognitiveservices/accounts--ModelRequests",
            "aggregation": 1,
            "splitBy": "ModelDeploymentName"
          }
        ]
      }
    }
  ]
}
