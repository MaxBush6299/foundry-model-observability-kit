    {
      "type": 9,
      "name": "investigation-parameters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "FoundryResource",
            "version": "KqlParameterItem/1.0",
            "name": "FoundryResource",
            "type": 5,
            "label": "Investigate resource",
            "isRequired": true,
            "value": "value::1",
            "query": "resources | where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions}) | where type =~ 'microsoft.cognitiveservices/accounts' and kind in~ ('AIServices', 'OpenAI') | where id in~ ({FoundryResources}) | extend Preferred=id =~ '__MODEL_ACCOUNT_RESOURCE_ID__' | order by Preferred desc, id asc | project value=id, label=strcat(name, ' (', resourceGroup, ')'), selected=id =~ '__MODEL_ACCOUNT_RESOURCE_ID__'",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::1"
              ],
              "showDefault": false
            }
          }
        ],
        "style": "pills"
      }
    },
    {
      "type": 1,
      "name": "detail-scope",
      "content": {
        "json": "### Investigate resource: {FoundryResource:name}\n`{FoundryResource}`\n\nARM summary tables below use this account only; estate comparison above remains scoped by **Compare accounts**."
      }
    },
    {
      "type": 1,
      "name": "status-by-deployment-label",
      "content": {
        "json": "### Deployment detail\nFor a specific deployment, find its HTTP status and request count here. Each row is one reported deployment and status combination; blank results do not establish zero errors."
      }
    },
    {
      "type": 3,
      "name": "status-by-deployment",
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{FoundryResource}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2018-01-01\"},{\"key\":\"metricnames\",\"value\":\"ModelRequests\"},{\"key\":\"aggregation\",\"value\":\"Total\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"$filter\",\"value\":\"ModelDeploymentName eq '*' and StatusCode eq '*'\"},{\"key\":\"top\",\"value\":\"1000\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries[*]\",\"columns\":[{\"path\":\"$.metadatavalues[0].value\",\"columnid\":\"Deployment\",\"columnType\":\"string\"},{\"path\":\"$.metadatavalues[1].value\",\"columnid\":\"HTTP status\",\"columnType\":\"string\"},{\"path\":\"$.data[0].total\",\"columnid\":\"Requests\",\"columnType\":\"long\"}]}}]}",
        "size": 0,
        "timeContextFromParameter": "TimeRange",
        "queryType": 12,
        "visualization": "grid"
      }
    },
