# Copy into .azure/<environment-name>/.env after running azd env new.
AZURE_ENV_NAME=foundry-model-observability-dev
AZURE_LOCATION=eastus
AZURE_SUBSCRIPTION_ID=<subscription-guid>
AZURE_RESOURCE_GROUP=rg-foundry-model-observability

# Existing account; the kit creates workbooks only, not the account or models.
MODEL_ACCOUNT_RESOURCE_ID=/subscriptions/<subscription-guid>/resourceGroups/<account-rg>/providers/Microsoft.CognitiveServices/accounts/<foundry-account>
